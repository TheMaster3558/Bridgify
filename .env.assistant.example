# Server/worker only. Never prefix provider credentials with NEXT_PUBLIC_.
# These factories are opt-in; placeholders do not enable a working integration.
PHOTON_HTTP_ADDRESS=https://your-provisioned-photon-middleware.example
PHOTON_TOKEN=
# Set only for a provisioned dedicated instance; omit for shared routing.
# PHOTON_INSTANCE_ID=
GEMINI_API_KEY=
# Choose the model available to the actual sponsor account; no default model.
GEMINI_MODEL=
# Server-side Postgres connection, with TLS settings supplied by your host.
DATABASE_URL=
# History uses real Supabase Auth; existing preview login does not create sessions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable ONLY after confirming the account uses Spectrum Cloud signed webhooks.
# Other Photon products/protocols are deliberately rejected, not guessed.
PHOTON_WEBHOOK_PROTOCOL=
# When confirmed: PHOTON_WEBHOOK_PROTOCOL=spectrum-cloud-v0
PHOTON_WEBHOOK_SIGNING_SECRET=
# Explicit configured provider-instance identity bound to this signing secret.
# Do not take this value from an unsigned inbound header or a client display name.
PHOTON_WEBHOOK_INSTANCE_ID=
# Optional: require the signed space.phone to match one configured receiving line.
# PHOTON_WEBHOOK_PHONE=
