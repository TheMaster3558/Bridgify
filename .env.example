# Web app; use your project's public anon/publishable key, never its service key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_BASE_URL=http://localhost:3000
# Server/worker only
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
# Agreement-only fallback for transient errors/quota; use none to disable.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
WORKER_ENABLED=true
# Private Postgres URI from Supabase Connect (session pooler works over IPv4).
DATABASE_URL=
# Production uses signed Photon push delivery. Local: npm run automation:sdk
# explicitly selects the live SDK, without changing the production mode here.
AUTOMATION_WORKER_ENABLED=true
AUTOMATION_INTAKE=webhook
# automation:worker also accepts sdk or history (explicit 30-second fallback).
# These signing variables are needed for webhooks, not local SDK intake:
# PHOTON_WEBHOOK_PROTOCOL=spectrum-cloud-v0
# PHOTON_WEBHOOK_SIGNING_SECRET=
# PHOTON_WEBHOOK_INSTANCE_ID=  # must equal SPECTRUM_PROJECT_ID
# Photon dedicated instance. Confirm all identifiers against your provisioned account.
PHOTON_HTTP_ADDRESS=
PHOTON_TOKEN=
PHOTON_INSTANCE_ID=
PHOTON_BOT_SENDER_ID=
# Settings sends its test message only to this chat GUID. The page cannot supply a different destination.
PHOTON_TEST_CHAT_GUID=
# Optional verified normalization gateway. Native Photon webhook verification
# must be implemented/tested in that gateway before enabling this mode.
PHOTON_WEBHOOK_MODE=
PHOTON_GATEWAY_SECRET=
# Photon Pro/Free project (project Settings). Project setup lists your Photon
# users and texts clients with these; server-only.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Vercel Hobby: Photon webhook triggers immediate processing; Supabase Cron resumes interrupted work.
AUTOMATION_PUBLIC_URL=https://bridgify-two.vercel.app
AUTOMATION_RUNNER_SECRET=
