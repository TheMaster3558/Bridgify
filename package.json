{
  "name": "bridgify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:assistant": "node --conditions=react-server --import tsx --test tests/assistant/*.test.ts",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --env-file=.env.local workers/index.ts",
    "automation:worker": "node --env-file=.env.local --conditions=react-server --import tsx workers/automation.ts",
    "automation:sdk": "node --env-file=.env.local --conditions=react-server --import tsx workers/automation-sdk.ts",
    "automation:sync": "node --env-file=.env.local --conditions=react-server --import tsx scripts/sync-automation.ts",
    "automation:install": "node --env-file=.env.local --import tsx scripts/install-automation.ts",
    "automation:process": "node --env-file=.env.local --conditions=react-server --import tsx scripts/process-automation.ts",
    "test:automation": "node --conditions=react-server --import tsx --test tests/automation/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "test:intake": "node --conditions=react-server --import tsx --test tests/intake/*.test.ts",
    "photon:demo": "node --env-file=.env.local --conditions=react-server --import tsx scripts/photon-reply-demo.ts",
    "worker:cleanup": "node --env-file=.env.local --conditions=react-server --import tsx workers/project-cleanup.ts",
    "automation:hosting": "node --env-file=.env.local --conditions=react-server --import tsx scripts/configure-automation-hosting.ts"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@photon-ai/advanced-imessage": "2.3.0",
    "@remixicon/react": "^4.9.0",
    "@spectrum-ts/core": "12.12.0",
    "@spectrum-ts/imessage": "12.11.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-aria-components": "^1.17.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "supabase": "^2.121.0",
    "tailwind-merge": "^3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
